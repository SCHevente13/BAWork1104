<Window x:Class="WpfApp5.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="TicketWindow" Height="580" Width="800">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#30343B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AAB3BF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="LightYellow"/>
                    <Setter Property="BorderBrush" Value="#275D91"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AAB3BF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightYellow"/>
                    <Setter Property="BorderBrush" Value="#275D91"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Mozijegy-foglalás" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
        <Label Content="Teljes név:" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="nameInput" Grid.Row="1" Grid.Column="1"/>
        <Label Content="Film címe:" Grid.Row="2" Grid.Column="0"/>
        <ComboBox x:Name="movieInput" Grid.Row="2" Grid.Column="1">
            <ComboBoxItem Content="Movie1"/>
            <ComboBoxItem Content="Movie2"/>
            <ComboBoxItem Content="Movie3"/>
            <ComboBoxItem Content="Movie4"/>
            <ComboBoxItem Content="Movie5"/>
        </ComboBox>
        <Label Content="Jegyek száma:" Grid.Row="3" Grid.Column="0"/>
        <TextBox x:Name="ticketInput" Grid.Row="3" Grid.Column="1"/>
        <CheckBox Content="VIP ülőhelyet kérek." x:Name="vipCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
        <Label Content="VIP jegy kiválasztva" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"/>
        <Button Content="Button" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"/>
        <Label Content="Yup" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
